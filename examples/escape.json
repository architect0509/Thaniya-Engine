 "scripts": [
  {
   "id": "sc_read",
   "name": "Readable",
   "code": "using UnityEngine;\n\n// 살펴보기: 주인공이 가까이에서 Space를 누르면 제목과 글을 대화창에 보여 줘요.\n// 쪽지 · 책장 · 잠긴 상자가 모두 이 스크립트를 써요 (인스펙터에서 글만 다르게)\npublic class Readable : MonoBehaviour\n{\n    public string title = \"쪽지\";\n    public string text = \"아무것도 적혀 있지 않다.\";\n\n    void OnInteract()\n    {\n        Dialog.Show(title, text);\n    }\n}\n"
  },
  {
   "id": "sc_lever",
   "name": "Lever",
   "code": "using UnityEngine;\n\n// 레버: 가까이에서 Space를 누르면 당겨져요.\n// 세 레버를 정해진 순서(order)대로 모두 당기면 상자가 열리고, 틀리면 모두 제자리로 돌아가요.\n// 쓰인 코드: OnInteract · Inventory(레버끼리 함께 쓰는 숫자) · GameObject.Find · transform.eulerAngles · Message.Show\npublic class Lever : MonoBehaviour\n{\n    [Tooltip(\"이 레버를 몇 번째로 당겨야 하나요? (1 ~ 3)\")]\n    public int order = 1;\n    public string color = \"빨강\";\n\n    // 레버 세 개가 함께 보는 「지금까지 맞게 당긴 수」는 소지품에 숫자로 넣어 둬요\n    const string STEP = \"레버 단계\";\n\n    void OnInteract()\n    {\n        // 손잡이가 오른쪽으로 돌아가 있으면(회전 70도) 이미 당긴 레버예요\n        if (transform.eulerAngles.z != 0)\n        {\n            Message.Show(\"이미 당긴 레버예요\");\n            return;\n        }\n\n        int step = Inventory.Count(STEP);\n        if (order == step + 1)                  // 순서가 맞았어요\n        {\n            transform.eulerAngles = new Vector3(0, 0, 70);   // 손잡이를 오른쪽으로 당겨요\n            Inventory.Add(STEP, 1);\n            Message.Show(color + \" 레버를 당겼어요 (\" + (step + 1) + \" / 3)\");\n            if (step + 1 == 3)\n            {\n                OpenChest();\n            }\n        }\n        else                                     // 틀렸어요 → 처음부터\n        {\n            Message.Show(\"덜컹! 순서가 틀려서 레버가 모두 제자리로 돌아갔어요\", 2.5f);\n            ResetAll();\n        }\n    }\n\n    void OpenChest()\n    {\n        GameObject.Find(\"잠긴 상자\").SetActive(false);\n        GameObject.Find(\"열린 상자\").SetActive(true);\n        UIScreen.SetText(\"목표\", \"내용\", \"어딘가에서 상자가 열렸어요!\");\n        Debug.Log(\"레버 퍼즐 성공 → 상자 열림\");\n    }\n\n    void ResetAll()\n    {\n        Inventory.Remove(STEP, Inventory.Count(STEP));\n        GameObject.Find(\"빨강 레버\").transform.eulerAngles = new Vector3(0, 0, 0);\n        GameObject.Find(\"초록 레버\").transform.eulerAngles = new Vector3(0, 0, 0);\n        GameObject.Find(\"파랑 레버\").transform.eulerAngles = new Vector3(0, 0, 0);\n    }\n}\n"
  },
  {
   "id": "sc_chest",
   "name": "TreasureChest",
   "code": "using UnityEngine;\n\n// 열린 상자: 처음 살펴보면 열쇠를 소지품에 넣어요.\npublic class TreasureChest : MonoBehaviour\n{\n    bool taken = false;\n\n    void OnInteract()\n    {\n        if (taken)\n        {\n            Dialog.Show(\"상자\", \"이제 텅 비어 있다.\");\n            return;\n        }\n        taken = true;\n        Inventory.Add(\"열쇠\", 1);\n        Dialog.Show(\"상자\", \"작은 황금 열쇠를 찾았다!\");\n        UIScreen.SetText(\"목표\", \"내용\", \"열쇠로 문을 열어 보세요\");\n        UIScreen.SetText(\"목표\", \"열쇠\", \"열쇠 1\");\n    }\n}\n"
  },
  {
   "id": "sc_door",
   "name": "LockedDoor",
   "code": "using UnityEngine;\n\n// 잠긴 문: 열쇠가 있으면 열리고(오브젝트가 사라져 지나갈 수 있어요), 없으면 잠겨 있다고 알려 줘요.\n// 문에는 트리거가 꺼진 박스 콜라이더 2D가 있어서 주인공을 막아요.\npublic class LockedDoor : MonoBehaviour\n{\n    public string keyName = \"열쇠\";\n\n    void OnInteract()\n    {\n        if (Inventory.Has(keyName))\n        {\n            Inventory.Remove(keyName, 1);\n            UIScreen.SetText(\"목표\", \"열쇠\", \"열쇠 0\");\n            UIScreen.SetText(\"목표\", \"내용\", \"문 밖으로 나가세요!\");\n            Message.Show(\"철컥! 문이 열렸어요\");\n            gameObject.SetActive(false);\n        }\n        else\n        {\n            Dialog.Show(\"문\", \"굳게 잠겨 있다. 열쇠가 필요해 보인다.\");\n        }\n    }\n}\n"
  },
  {
   "id": "sc_exit",
   "name": "ExitZone",
   "code": "using UnityEngine;\n\n// 출구: 주인공이 들어오면 탈출 성공 화면을 띄우고 걸린 시간을 보여 줘요.\n// 쓰인 코드: OnTriggerEnter2D · Time.time · Mathf.RoundToInt · UIScreen.Show\npublic class ExitZone : MonoBehaviour\n{\n    bool done = false;\n\n    void OnTriggerEnter2D(Collider2D other)\n    {\n        if (done) return;\n        done = true;\n\n        int sec = Mathf.RoundToInt(Time.time);\n        UIScreen.SetText(\"탈출\", \"기록\", \"걸린 시간 \" + sec + \"초\");\n        UIScreen.Hide(\"목표\");\n        UIScreen.Show(\"탈출\");\n        Debug.Log(\"탈출 성공! \" + sec + \"초\");\n    }\n}\n"
  },
  {
   "id": "jhruq7a",
   "name": "HeroTileMovement",
   "code": "using UnityEngine;\n\n// 주인공 이동 스크립트 (타일형)\n// 주인공 컴포넌트를 추가하면 기본으로 붙습니다. 방향키/WASD를 누르면 칸 가운데에서 옆 칸 가운데로 한 칸씩 걸어갑니다 (좀비고처럼).\n// 짧게 누르면 딱 한 칸, holdDelay(초)보다 오래 누르고 있으면 멈추지 않고 칸 단위로 이어서 걷습니다.\n// 대각선 없이 상하좌우로만 움직입니다.\n// 막힌 칸(벽 · NPC · 박스 콜라이더)으로는 가지 않고 그쪽을 바라보기만 합니다.\n// 칸에 묶이지 않고 픽셀 단위로 부드럽게 움직이려면 컴포넌트 추가에서 「주인공 이동 (픽셀형)」으로 바꾸세요.\n// 걷기·대기 그림은 애니메이터 컴포넌트가 정합니다. 이 스크립트는 애니메이터 파라미터\n// IsMoving(걷는 중인지)과 Dir(0 아래 · 1 위 · 2 왼쪽 · 3 오른쪽)만 바꿔 줍니다.\n// 좌표: 오른쪽이 +x, 아래쪽이 +y 입니다 (단위: 칸 · 정수 좌표가 칸 가운데).\npublic class HeroTileMovement : MonoBehaviour\n{\n    [Header(\"이동\")]\n    [Tooltip(\"1초에 이동하는 칸 수입니다\")]\n    public float speed = 5f;\n\n    [Tooltip(\"이 시간(초)보다 오래 누르고 있으면 계속 걷습니다. 그보다 짧게 누르면 한 칸만 갑니다\")]\n    [Range(0, 1)]\n    public float holdDelay = 0.15f;\n\n    [Header(\"달리기\")]\n    [Tooltip(\"Shift를 누르고 있는 동안 곱해지는 속도 배율입니다\")]\n    [Range(1, 3)]\n    public float runMultiplier = 1.6f;\n\n    private Hero hero;\n    private Animator animator;\n    private bool stepping = false;     // 한 칸을 걷는 중인지\n    private Vector2 target;            // 이번 걸음의 도착 칸\n    private Vector2 dir;               // 마지막으로 걸은 방향\n    private float lastH = 0f;          // 지난 프레임의 입력\n    private float lastV = 0f;\n    private float holdTime = 0f;       // 같은 방향을 누르고 있는 시간\n    private bool queued = false;       // 걷는 도중 새로 누른 입력 (도착하면 그 방향으로 한 칸 더)\n    private float queuedH = 0f;\n    private float queuedV = 0f;\n\n    void Start()\n    {\n        hero = GetComponent<Hero>();\n        animator = GetComponent<Animator>();     // 애니메이터 컴포넌트 (없으면 null)\n        hero.position = Snap(hero.position);     // 칸 가운데에서 시작\n    }\n\n    void Update()\n    {\n        // 왼쪽 -1 · 오른쪽 +1 / 위 -1 · 아래 +1\n        float h = Input.GetAxisRaw(\"Horizontal\");\n        float v = Input.GetAxisRaw(\"Vertical\");\n\n        // 두 방향을 함께 누르면 지금 걷던 축을 그대로 (대각선 없음)\n        if (h != 0 && v != 0)\n        {\n            if (dir.x != 0)\n                v = 0;\n            else\n                h = 0;\n        }\n        bool pressing = h != 0 || v != 0;\n        bool fresh = pressing && (h != lastH || v != lastV);   // 방금 눌렀거나 방향을 바꿈\n        lastH = h;\n        lastV = v;\n        if (fresh)\n            holdTime = 0f;\n        if (pressing)\n            holdTime += Time.deltaTime;\n        else\n            holdTime = 0f;\n\n        if (!stepping)\n        {\n            // 새로 누르면 한 칸 · 오래 누르고 있으면 계속\n            if (fresh || (pressing && holdTime >= holdDelay))\n                StartStep(h, v);\n        }\n        else if (fresh)\n        {\n            queued = true;\n            queuedH = h;\n            queuedV = v;\n        }\n\n        if (stepping)\n        {\n            float s = speed;\n            if (Input.GetKey(KeyCode.LeftShift))\n                s = s * runMultiplier;\n\n            // 이번 프레임에 걸을 거리 — 칸에 도착하고 남은 거리는 다음 칸으로 이어서 씁니다 (칸마다 끊기지 않게)\n            float budget = s * Time.deltaTime;\n            Vector2 next = Vector2.MoveTowards(hero.position, target, budget);\n            budget = budget - Vector2.Distance(hero.position, next);\n            if (!hero.Move(next - hero.position))\n            {\n                // 걷는 도중 길이 막히면(몬스터가 끼어듦 등) 가까운 칸 가운데로 돌아갑니다\n                target = Snap(hero.position);\n                budget = 0f;\n            }\n            if (Vector2.Distance(hero.position, target) < 0.01f)\n            {\n                hero.position = target;          // 칸 가운데에 딱 맞춤\n                stepping = false;\n                // 걷는 도중 다시 눌렀거나 오래 누르고 있으면 멈추지 않고 다음 칸으로\n                if (queued)\n                    StartStep(queuedH, queuedV);\n                else if (pressing && holdTime >= holdDelay)\n                    StartStep(h, v);\n                queued = false;\n                // 남은 거리만큼 다음 칸으로 바로 출발\n                if (stepping && budget > 0f)\n                {\n                    Vector2 more = Vector2.MoveTowards(hero.position, target, budget);\n                    hero.Move(more - hero.position);\n                }\n            }\n        }\n\n        // 애니메이터 창의 상태(대기_아래, 걷기_오른쪽 …)가 이 파라미터로 바뀝니다\n        if (animator != null)\n            animator.SetBool(\"IsMoving\", stepping);\n    }\n\n    // 옆 칸으로 한 걸음을 시작합니다 (막혀 있으면 바라보기만)\n    void StartStep(float h, float v)\n    {\n        dir = new Vector2(h, v);\n        hero.Face(dir);                          // 바라보는 방향 (공격·손전등 방향에 쓰임)\n        if (animator != null)\n            animator.SetInteger(\"Dir\", DirIndex(h, v));\n\n        if (!hero.canMove)                       // 대화 중에는 움직이지 않음\n            return;\n        if (!hero.CanMove(dir))                  // 막힌 칸이면 바라보기만\n            return;\n\n        target = Snap(hero.position) + dir;\n        stepping = true;\n    }\n\n    // 가장 가까운 칸 가운데 좌표\n    Vector2 Snap(Vector2 p)\n    {\n        return new Vector2(Mathf.Round(p.x), Mathf.Round(p.y));\n    }\n\n    // 입력 방향 → 애니메이터 Dir 값\n    int DirIndex(float h, float v)\n    {\n        if (Mathf.Abs(h) > Mathf.Abs(v))\n            return h < 0 ? 2 : 3;\n        return v < 0 ? 1 : 0;\n    }\n}\n"
  },
  {
   "id": "yk6z9x1",
   "name": "HeroCombat",
   "code": "using UnityEngine;\n\n// 주인공 행동 스크립트 (말 걸기 · 공격)\n// 주인공 컴포넌트를 추가하면 함께 붙습니다. Space · Z · Enter 를 누르면\n//   ① 가까이에 OnInteract()를 가진 오브젝트(NPC 등)가 있으면 그 오브젝트의 OnInteract()를 부르고\n//   ② 없으면 바라보는 방향으로 공격합니다.\n// 키·공격력·사거리를 바꾸거나, 공격 대신 다른 행동을 넣어도 됩니다.\npublic class HeroCombat : MonoBehaviour\n{\n    [Header(\"공격\")]\n    [Tooltip(\"한 번 공격할 때 몬스터에게 주는 피해입니다\")]\n    public int damage = 1;\n\n    [Tooltip(\"공격이 닿는 거리(칸)입니다\")]\n    public float reach = 0.7f;\n\n    [Header(\"말 걸기\")]\n    [Tooltip(\"이 거리(칸) 안에 있는 NPC 등에게 말을 겁니다\")]\n    public float talkDistance = 1.4f;\n\n    private Hero hero;\n\n    void Start()\n    {\n        hero = GetComponent<Hero>();\n    }\n\n    void Update()\n    {\n        bool pressed = Input.GetKeyDown(KeyCode.Space) || Input.GetKeyDown(KeyCode.Z) || Input.GetKeyDown(KeyCode.Return);\n        if (!pressed)\n        {\n            return;\n        }\n\n        // 가까운 대상의 OnInteract()를 부릅니다 (NpcTalk 스크립트 → 대화창)\n        if (hero.Interact(talkDistance))\n        {\n            return;\n        }\n\n        // 맞은 몬스터는 체력이 줄고 뒤로 밀려납니다. OnHit()을 가진 오브젝트에는 OnHit()을 보냅니다\n        hero.Attack(damage, reach);\n    }\n}\n"
  }
 ],
